# fake   — демо-режим без LLM, ничего настраивать не нужно
# openai — любой OpenAI-совместимый API: Ollama, OpenRouter и др.
LLM_PROVIDER=fake

# Для Ollama (локально, бесплатно):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# Сколько раз агенты могут переделать работу по замечаниям критика
MAX_REVIEW_ROUNDS=1
